# Local-only DEMO database defaults, matching infra/compose.yaml
DATABASE_URL=postgresql+psycopg://app_user:demo_app@127.0.0.1:55432/paypilot
PAYMENT_READONLY_DATABASE_URL=postgresql+psycopg://metric_reader:demo_read@127.0.0.1:55432/paypilot
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:demo_admin@127.0.0.1:55432/paypilot
# Set LLM_PROVIDER=deepseek to enable the official DeepSeek API.
# Export DEEPSEEK_API_KEY in the backend shell or add it to the private .env.
# The default DeepSeek model is deepseek-flash; LLM_MODEL_ID can override it.
LLM_PROVIDER=rules
# For a chat-completions compatible endpoint, set LLM_PROVIDER=compatible and all three values below.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL_ID=your-model-id
# LLM_API_KEY=your-local-secret
AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_RUN_TIMEOUT_SECONDS=30
